---
import type { GetStaticPaths } from "astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Gallery from "../components/Gallery.astro";
import Lightbox from "../components/Lightbox.astro";
import { categories, getCover, getPhotos, type Category } from "../lib/gallery";

export const getStaticPaths = (() =>
  categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }))) satisfies GetStaticPaths;

interface Props {
  category: Category;
}

const { category } = Astro.props;
const photos = getPhotos(category.slug);
const cover = getCover(category);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Layout
  title={`${category.name} · Comforts From Home`}
  description={`${category.description} Hand-knit in Canmore, Alberta.`}
  ogImage={cover?.src}
  ogImageAlt={cover?.alt}
>
  <Header />
  <main id="main" class="section">
    <div class="container">
      <a class="back-link" href={`${base}#work`}>
        ← All work
      </a>
      <header class="page-intro">
        <p class="eyebrow">The Work</p>
        <h1>{category.name}</h1>
        <p class="lede">{category.description}</p>
      </header>
      <Gallery photos={photos} />
      <Lightbox />
      <p class="gallery-cta">
        Like something you see?{" "}
        <a href={`${base}#contact`}>Ask about a custom order</a>
      </p>
    </div>
  </main>
  <Footer />
</Layout>
