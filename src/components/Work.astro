---
import { Image } from "astro:assets";
import { categories, getCover, getPhotos } from "../lib/gallery";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const cards = categories.map((category) => ({
  ...category,
  cover: getCover(category),
  count: getPhotos(category.slug).length,
}));
---

<section id="work" class="section alt">
  <div class="container">
    <h2>The Work</h2>
    <div class="grid">
      {cards.map((card) => (
        <a class="card" href={`${base}${card.slug}/`}>
          {card.cover && (
            <Image
              class="card-img"
              src={card.cover.src}
              alt={card.cover.alt}
              width={800}
              widths={[400, 600, 800]}
              sizes="(min-width: 800px) 320px, 100vw"
              style={
                card.cover.position
                  ? `object-position: ${card.cover.position}`
                  : undefined
              }
            />
          )}
          <h3>{card.name}</h3>
          <p>{card.description}</p>
          <span class="card-link">
            {card.count === 1 ? "1 piece" : `${card.count} pieces`}
            <span aria-hidden="true"> →</span>
          </span>
        </a>
      ))}
    </div>
    <p class="section-cta">
      <a class="button" href={`${base}gallery/`}>
        Browse the full gallery
      </a>
    </p>
  </div>
</section>
