<dialog class="lightbox" aria-label="Photo viewer" data-lightbox>
  <figure class="lightbox-figure">
    <img class="lightbox-img" alt="" />
    <figcaption class="lightbox-caption"></figcaption>
  </figure>
  <p class="lightbox-count" aria-live="polite"></p>
  <button class="lightbox-btn lightbox-close" type="button" aria-label="Close">
    ✕
  </button>
  <button
    class="lightbox-btn lightbox-prev"
    type="button"
    aria-label="Previous photo"
  >
    ‹
  </button>
  <button
    class="lightbox-btn lightbox-next"
    type="button"
    aria-label="Next photo"
  >
    ›
  </button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  // Every gallery on the page shares one viewer, so arrows move across all of them.
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-gallery] a"),
  );

  if (dialog && links.length && typeof dialog.showModal === "function") {
    const img = dialog.querySelector<HTMLImageElement>(".lightbox-img")!;
    const caption = dialog.querySelector<HTMLElement>(".lightbox-caption")!;
    const count = dialog.querySelector<HTMLElement>(".lightbox-count")!;
    const prev = dialog.querySelector<HTMLButtonElement>(".lightbox-prev")!;
    const next = dialog.querySelector<HTMLButtonElement>(".lightbox-next")!;
    let index = 0;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const link = links[index];
      img.src = link.dataset.full ?? link.href;
      img.alt = link.dataset.alt ?? "";
      caption.textContent = link.dataset.caption ?? "";
      caption.hidden = !link.dataset.caption;
      count.textContent = `${index + 1} / ${links.length}`;
      // Warm the cache for the neighbours.
      for (const n of [index - 1, index + 1]) {
        const l = links[(n + links.length) % links.length];
        new Image().src = l.dataset.full ?? l.href;
      }
    };

    const single = links.length < 2;
    prev.hidden = single;
    next.hidden = single;

    links.forEach((link, i) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        show(i);
        dialog.showModal();
      });
    });

    prev.addEventListener("click", () => show(index - 1));
    next.addEventListener("click", () => show(index + 1));
    dialog
      .querySelector(".lightbox-close")!
      .addEventListener("click", () => dialog.close());

    // Click on the backdrop (outside the photo) closes.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(index - 1);
      if (event.key === "ArrowRight") show(index + 1);
    });

    // Return focus to the photo that was opened.
    dialog.addEventListener("close", () => links[index]?.focus());

    let touchX: number | null = null;
    dialog.addEventListener(
      "touchstart",
      (e) => (touchX = e.touches[0].clientX),
      { passive: true },
    );
    dialog.addEventListener("touchend", (e) => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
      touchX = null;
    });
  }
</script>
